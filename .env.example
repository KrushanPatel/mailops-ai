DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailops
REDIS_URL=redis://localhost:6379

# Any LangChain-supported provider works here (openai, anthropic, google_genai,
# deepseek, ollama, groq, together, ...) — just install its langchain-<provider>
# package and point these at it. CHAT_API_KEY/EMBEDDING_API_KEY and
# CHAT_BASE_URL/EMBEDDING_BASE_URL are optional (e.g. Ollama needs neither).
CHAT_PROVIDER=google_genai
CHAT_MODEL=gemini-2.0-flash
CHAT_API_KEY=your_gemini_api_key_here
CHAT_BASE_URL=

EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=your_gemini_api_key_here
EMBEDDING_BASE_URL=
